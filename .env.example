# ── AI Receptionist — Environment Variables ──────────────────────────────
# Copy to .env and fill in values before running docker compose

# ── LLM Keys (at least one required) ────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Default Provider ─────────────────────────────────────────────────────
# Options: deepseek | anthropic | openai
DEFAULT_LLM_PROVIDER=deepseek

# ── Security — MUST change all of these in production ────────────────────
# Generate with: openssl rand -hex 32
API_SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET_MIN_32_CHARS

# JWT signing secrets (different from API_SECRET_KEY)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS

# JWT token lifetimes
JWT_ACCESS_TTL_SEC=900      # 15 minutes
JWT_REFRESH_TTL_SEC=604800  # 7 days

# ── Admin user (created on first boot) ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_12_CHARS

# ── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
