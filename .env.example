# ── AI Receptionist — Environment Variables ──────────────────────────────
# Copy to .env and fill in values before running docker compose

# ── LLM Keys (at least one required) ────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Default Provider ─────────────────────────────────────────────────────
# Options: deepseek | anthropic | openai
DEFAULT_LLM_PROVIDER=deepseek

# ── Security (MUST change in production) ────────────────────────────────
# Generate with: openssl rand -hex 32
API_SECRET_KEY=CHANGE_ME_TO_A_STRONG_SECRET_MIN_32_CHARS

# ── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Vector DB path (set automatically in Docker via volume) ──────────────
# VECTOR_DB_PATH=/app/data/vectordb
