# Backend env — copy to .env for local dev
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=deepseek

# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_must_be_32_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_32_chars_min
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!devonly

VECTOR_DB_PATH=./data/vectordb
HF_HOME=./data/models
DATA_PATH=./data

RATE_LIMIT_GLOBAL=30/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_INGEST=10/minute

FRONTEND_URL=http://localhost:3000
LOG_LEVEL=DEBUG
DEBUG=true
PORT=3001
