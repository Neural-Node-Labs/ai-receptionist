# LLM Provider Keys
DEEPSEEK_API_KEY=your_deepseek_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# Default LLM provider: deepseek | anthropic | openai
DEFAULT_LLM_PROVIDER=deepseek

# Security
API_SECRET_KEY=change_this_to_a_strong_random_secret_min_32_chars
FRONTEND_URL=http://localhost:3000

# RAG Configuration
VECTOR_DB_PATH=/app/data/vectordb
KNOWLEDGE_BASE_PATH=/app/data/knowledge

# Rate Limiting
RATE_LIMIT_POINTS=30
RATE_LIMIT_DURATION=60

# Logging
LOG_LEVEL=info
NODE_ENV=production
